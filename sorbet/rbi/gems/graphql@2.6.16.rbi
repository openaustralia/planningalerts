module GraphQL::Language::Nodes; end

# [AbstractNode](rdoc-ref:GraphQL::Language::Nodes::AbstractNode) is the base class for all nodes in a GraphQL AST.
#
# It provides some APIs for working with ASTs:
# - `children` returns all AST nodes attached to this one. Used for tree traversal.
# - `scalars` returns all scalar (Ruby) values attached to this one. Used for comparing nodes.
# - `to_query_string` turns an AST node into a GraphQL string
#
# source://graphql//lib/graphql/language/nodes.rb#14
class GraphQL::Language::Nodes::AbstractNode
  # Value equality
  #
  # **Returns**
  #
  # - `Boolean` — True if `self` is equivalent to `other`
  #
  # :call-seq:
  #   ==(other) -> bool
  #
  # source://graphql//lib/graphql/language/nodes.rb#66
  def ==(other); end

  # **Returns**
  #
  # - `Array<GraphQL::Language::Nodes::AbstractNode>` — all nodes in the tree below this one
  #
  # :call-seq:
  #   children() -> Array[GraphQL::Language::Nodes::AbstractNode]
  # : -> Array[AbstractNode]
  #
  # source://graphql//lib/graphql/language/nodes.rb#82
  def children; end

  # source://graphql//lib/graphql/language/nodes.rb#104
  def children_method_name; end

  # : -> Integer?
  #
  # source://graphql//lib/graphql/language/nodes.rb#49
  def col; end

  # : -> Integer?
  #
  # source://graphql//lib/graphql/language/nodes.rb#54
  def definition_line; end

  # TODO DRY with `replace_child`
  #
  # source://graphql//lib/graphql/language/nodes.rb#177
  def delete_child(previous_child); end

  # : String?
  #
  # source://graphql//lib/graphql/language/nodes.rb#41
  def filename; end

  # : -> Integer?
  #
  # source://graphql//lib/graphql/language/nodes.rb#44
  def line; end

  # This creates a copy of `self`, with `new_options` applied.
  #
  # **Parameters**
  #
  # - `new_options` (`Hash`)
  #
  # **Returns**
  #
  # - `AbstractNode` — a shallow copy of `self`
  #
  # :call-seq:
  #   merge(Hash new_options) -> AbstractNode
  #
  # source://graphql//lib/graphql/language/nodes.rb#150
  def merge(new_options); end

  # : -> [Integer?, Integer?]
  #
  # source://graphql//lib/graphql/language/nodes.rb#121
  def position; end

  # Copy `self`, but modify the copy so that `previous_child` is replaced by `new_child`
  #
  # source://graphql//lib/graphql/language/nodes.rb#155
  def replace_child(previous_child, new_child); end

  # **Returns**
  #
  # - `Array<Integer, Float, String, Boolean, Array>` — Scalar values attached to this node
  #
  # :call-seq:
  #   scalars() -> Array[Integer | Float | String | bool | Array]
  # : -> Array[untyped]
  #
  # source://graphql//lib/graphql/language/nodes.rb#93
  def scalars; end

  # : (?printer: untyped) -> String
  #
  # source://graphql//lib/graphql/language/nodes.rb#126
  def to_query_string(printer: T.unsafe(nil)); end

  # Built-in node classes override this with a literal Symbol.
  #
  # **Returns**
  #
  # - `Symbol` — the method that GraphQL::Language::Visitor calls for this node
  #
  # :call-seq:
  #   visit_method() -> Symbol
  #
  # source://graphql//lib/graphql/language/nodes.rb#116
  def visit_method; end

  protected

  # source://graphql//lib/graphql/language/nodes.rb#191
  def merge!(new_options); end

  private

  # This might be unnecessary, but its easiest to add it here.
  #
  # source://graphql//lib/graphql/language/nodes.rb#98
  def initialize_copy(other); end

  class << self
    # Returns the value of attribute children_method_name.
    #
    # source://graphql//lib/graphql/language/nodes.rb#205
    def children_method_name; end

    # Sets the attribute children_method_name
    #
    # @param value the value to set the attribute children_method_name to.
    #
    # source://graphql//lib/graphql/language/nodes.rb#205
    def children_method_name=(_arg0); end

    # **Returns**
    #
    # - `Hash{Symbol => Class, nil}, nil` — child reader methods and the kind of node each one returns, if known
    #
    # :call-seq:
    #   children_of_type() -> Hash[Symbol, Class | nil] | nil
    #
    # source://graphql//lib/graphql/language/nodes.rb#225
    def children_of_type; end

    # Add a default `.visit_method` and `.children_method_name` using the class name
    #
    # source://graphql//lib/graphql/language/nodes.rb#208
    def inherited(child_class); end

    # **Returns**
    #
    # - `Symbol` — the method that GraphQL::Language::Visitor calls for this kind of node
    # : Symbol?
    #
    # source://graphql//lib/graphql/language/nodes.rb#203
    def visit_method; end
  end
end

