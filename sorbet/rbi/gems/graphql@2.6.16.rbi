  # source://graphql//lib/graphql/schema/resolver.rb#240
  def ready?(**args); end

  # Do the work. Everything happens here.
  #
  # **Returns**
  #
  # - `Object` — An object corresponding to the return type
  #
  # :call-seq:
  #   resolve(**args) -> Object
  #
  # @raise [GraphQL::RequiredImplementationMissingError]
  #
  # source://graphql//lib/graphql/schema/resolver.rb#215
  def resolve(**args); end

  # This method is _actually_ called by the runtime,
  # it does some preparation and then eventually calls
  # the user-defined `#resolve` method.
  #
  # source://graphql//lib/graphql/schema/resolver.rb#149
  def resolve_with_support(**args); end

