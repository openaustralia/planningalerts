# Adds `field(...)` helper to resolvers so that they can
# generate payload types.
#
# Or, an already-defined one can be attached with `payload_type(...)`.
# --
# @requires_ancestor: singleton(GraphQL::Schema::Resolver)
# @requires_ancestor: GraphQL::Schema::Member::HasFields
#
# source://graphql//lib/graphql/schema/resolver/has_payload_type.rb#15
module GraphQL::Schema::Resolver::HasPayloadType
  # source://graphql//lib/graphql/schema/resolver/has_payload_type.rb#85
  def field(*args, **kwargs, &block); end

  # source://graphql//lib/graphql/schema/resolver/has_payload_type.rb#50
  def field_class(new_class = T.unsafe(nil)); end

  # An object class to use for deriving return types
  #
  # **Parameters**
  #
  # - `new_class` (`Class, nil`) — Defaults to [GraphQL::Schema::Object](rdoc-ref:GraphQL::Schema::Object)
  #
  # **Returns**
  #
  # - `Class`
  #
  # :call-seq:
  #   object_class(Class | nil new_class) -> Class
  #
  # source://graphql//lib/graphql/schema/resolver/has_payload_type.rb#72
  def object_class(new_class = T.unsafe(nil)); end

  # Call this method to get the derived return type of the mutation,
  # or use it as a configuration method to assign a return type
  # instead of generating one.
  #
  # **Parameters**
  #
  # - `new_payload_type` (`Class, nil`) — If a type definition class is provided, it will be used as the return type of the mutation field
  #
  # **Returns**
  #
  # - `Class` — The object type which this mutation returns.
  #
  # :call-seq:
  #   payload_type(Class | nil new_payload_type) -> Class
  #
  # source://graphql//lib/graphql/schema/resolver/has_payload_type.rb#30
  def payload_type(new_payload_type = T.unsafe(nil)); end

  # source://graphql//lib/graphql/schema/resolver/has_payload_type.rb#37
  def type(new_type = T.unsafe(nil), null: T.unsafe(nil)); end

  # Call this method to get the derived return type of the mutation,
  # or use it as a configuration method to assign a return type
  # instead of generating one.
  #
  # **Parameters**
  #
  # - `new_payload_type` (`Class, nil`) — If a type definition class is provided, it will be used as the return type of the mutation field
  #
  # **Returns**
  #
  # - `Class` — The object type which this mutation returns.
  #
  # :call-seq:
  #   payload_type(Class | nil new_payload_type) -> Class
  #
  # source://graphql//lib/graphql/schema/resolver/has_payload_type.rb#30
  def type_expr(new_payload_type = T.unsafe(nil)); end

  private

  # Build a subclass of [.object_class](rdoc-ref:.object_class) based on `self`.
  # This value will be cached as [.payload_type](rdoc-ref:.payload_type).
  # Override this hook to customize return type generation.
  #
  # source://graphql//lib/graphql/schema/resolver/has_payload_type.rb#112
  def generate_payload_type; end
end

# source://graphql//lib/graphql/schema/resolver/has_payload_type.rb#83
GraphQL::Schema::Resolver::HasPayloadType::NO_INTERFACES = T.let(T.unsafe(nil), Array)

# source://graphql//lib/graphql/schema/scalar.rb#6
class GraphQL::Schema::Scalar < ::GraphQL::Schema::Member
  extend ::GraphQL::Schema::Member::ValidatesInput

  class << self
    # : (untyped val, GraphQL::Query::Context ctx) -> untyped
    #
    # source://graphql//lib/graphql/schema/scalar.rb#11
    def coerce_input(val, ctx); end

    # : (untyped val, GraphQL::Query::Context ctx) -> untyped
    #
    # source://graphql//lib/graphql/schema/scalar.rb#16
    def coerce_result(val, ctx); end

    # : (?bool? is_default) -> bool?
    #
    # source://graphql//lib/graphql/schema/scalar.rb#39
    def default_scalar(is_default = T.unsafe(nil)); end

    # : -> bool
    #
    # @return [Boolean]
    #
    # source://graphql//lib/graphql/schema/scalar.rb#47
    def default_scalar?; end

    # : -> GraphQL::TypeKinds::TypeKind
    #
    # source://graphql//lib/graphql/schema/scalar.rb#21
    def kind; end

    # : (?String? new_url) -> String?
    #
    # source://graphql//lib/graphql/schema/scalar.rb#26
    def specified_by_url(new_url = T.unsafe(nil)); end

    # Coerce `value` with [coerce_input](rdoc-ref:::coerce_input) and report any problems.
    #
    # GraphQL-Ruby calls this for variable and literal input values. When the value is valid,
    # it returns a result with [coerced_value](rdoc-ref:GraphQL::Query::InputValidationResult#coerced_value),
    # which is used as the argument value.
    #
    # Overrides may return `InputValidationResult.coerced(value)` to provide a coerced value (including `nil`).
    # If an override returns a valid result _without_ a coerced value, `coerce_input` will be called at runtime,
    # and any `GraphQL::CoercionError` it raises will be added as a field error.
    #
    # **Returns**
    #
    # - `GraphQL::Query::InputValidationResult, nil`
    #
    # :call-seq:
    #   validate_non_null_input(value, ctx, max_errors:) -> GraphQL::Query::InputValidationResult | nil
    # : (untyped value, GraphQL::Query::Context ctx, ?max_errors: Integer?) -> GraphQL::Query::InputValidationResult?
    #
    # source://graphql//lib/graphql/schema/scalar.rb#68
    def validate_non_null_input(value, ctx, max_errors: T.unsafe(nil)); end
  end
end

