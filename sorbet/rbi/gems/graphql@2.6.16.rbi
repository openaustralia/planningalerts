  #
  # :call-seq:
  #   visible_field?(field_defn, _ctx, Class | Module owner)
  #
  # @return [Boolean]
  #
  # source://graphql//lib/graphql/schema/warden.rb#461
  def visible_field?(field_defn, _ctx = T.unsafe(nil), owner = T.unsafe(nil)); end

  # @return [Boolean]
  #
  # source://graphql//lib/graphql/schema/warden.rb#475
  def visible_type?(type_defn, _ctx = T.unsafe(nil)); end

  # @return [Boolean]
  #
  # source://graphql//lib/graphql/schema/warden.rb#480
