  # map keyed by response key, then compare within each group.
  #
  # source://graphql//lib/graphql/static_validation/rules/fields_will_merge.rb#248
  def conflicts_within_selection_set(node, parent_type); end

  # source://graphql//lib/graphql/static_validation/rules/fields_will_merge.rb#666
