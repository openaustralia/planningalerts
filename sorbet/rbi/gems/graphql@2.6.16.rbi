# See [GraphQL::Railtie](rdoc-ref:GraphQL::Railtie) for automatic Rails integration
# --
# @requires_ancestor: Module
#
# source://graphql//lib/graphql/autoload.rb#9
module GraphQL::Autoload
  # Register a constant named `const_name` to be loaded from `path`.
  # This is like `Kernel#autoload` but it tracks the constants so they can be eager-loaded with [eager load!](rdoc-ref:#eager_load!)
  #
  # **Parameters**
  #
  # - `const_name` (`Symbol`)
  # - `path` (`String`)
  #
  # **Returns**
  #
  # - `void`
  #
  # :call-seq:
  #   autoload(Symbol const_name, String path) -> void
  #
  # source://graphql//lib/graphql/autoload.rb#24
  def autoload(const_name, path); end

  # Call this to load this constant's `autoload` dependents and continue calling recursively
  #
  # **Returns**
  #
  # - `void`
  #
  # :call-seq:
  #   eager_load!() -> void
  #
  # source://graphql//lib/graphql/autoload.rb#39
  def eager_load!; end

  private

  # **Returns**
  #
  # - `Boolean` — `true` if GraphQL-Ruby is currently eager-loading its constants
  #
  # :call-seq:
  #   eager_loading?() -> bool
  #
  # @return [Boolean]
  #
  # source://graphql//lib/graphql/autoload.rb#58
  def eager_loading?; end
end

# Wrap unhandled errors with [TracedError](rdoc-ref:TracedError).
#
# [TracedError](rdoc-ref:TracedError) provides a GraphQL backtrace with arguments and return values.
# The underlying error is available as `TracedError#cause`.
#
# **Examples**
#
# **Example: toggling backtrace annotation**
#
# ```ruby
# class MySchema < GraphQL::Schema
#   if Rails.env.development? || Rails.env.test?
#     use GraphQL::Backtrace
#   end
# end
# ```
#
# source://graphql//lib/graphql/backtrace/table.rb#5
class GraphQL::Backtrace
  include ::Enumerable
  extend ::Forwardable

  # @return [Backtrace] a new instance of Backtrace
  #
  # source://graphql//lib/graphql/backtrace.rb#33
  def initialize(context, value: T.unsafe(nil)); end

  # source://forwardable/1.3.3/forwardable.rb#231
  def [](*args, **_arg1, &block); end

  # source://forwardable/1.3.3/forwardable.rb#231
  def each(*args, **_arg1, &block); end

  # source://graphql//lib/graphql/backtrace.rb#37
  def inspect; end

  # source://graphql//lib/graphql/backtrace.rb#43
  def to_a; end

  # source://graphql//lib/graphql/backtrace.rb#37
  def to_s; end

  class << self
    # source://graphql//lib/graphql/backtrace.rb#29
    def use(schema_defn); end
  end
end

# A class for turning a context into a human-readable table or array
