# This wraps a value which is available, but not yet calculated, like a promise or future.
#
# Calling `#value` will trigger calculation & return the "lazy" value.
#
# This is an itty-bitty promise-like object, with key differences:
# - It has only two states, not-resolved and resolved
# - It has no error-catching functionality
#
# source://graphql//lib/graphql/execution/lazy/lazy_method_map.rb#13
class GraphQL::Execution::Lazy
  # Create a [Lazy](rdoc-ref:Lazy) which will get its inner value by calling the block
  #
  # **Parameters**
  #
  # - `field` (`GraphQL::Schema::Field`)
  # - `get_value_func` (`Proc`) — a block to get the inner value (later)
  #
  # :call-seq:
  #   initialize(GraphQL::Schema::Field field:, Proc &get_value_func)
  #
  # @return [Lazy] a new instance of Lazy
  #
  # source://graphql//lib/graphql/execution/lazy.rb#27
  def initialize(field: T.unsafe(nil), &get_value_func); end

  # source://graphql//lib/graphql/execution/lazy.rb#16
  def field; end

  # **Returns**
  #
  # - `Lazy` — A [Lazy](rdoc-ref:Lazy) whose value depends on another [Lazy](rdoc-ref:Lazy), plus any transformations in `block`
  #
  # :call-seq:
  #   then() -> Lazy
  #
  # source://graphql//lib/graphql/execution/lazy.rb#66
  def then; end

  # **Returns**
  #
  # - `Object` — The wrapped value, calling the lazy block if necessary
  #
  # :call-seq:
  #   value() -> Object
  #
  # source://graphql//lib/graphql/execution/lazy.rb#39
  def value; end

  class << self
    # **Parameters**
    #
    # - `lazies` (`Array<Object>`) — Maybe-lazy objects
    #
    # **Returns**
    #
    # - `Lazy` — A lazy which will sync all of `lazies`
    #
    # :call-seq:
    #   all(Array[Object] lazies) -> Lazy
    #
    # source://graphql//lib/graphql/execution/lazy.rb#82
    def all(lazies); end
  end
end

# [GraphQL::Schema](rdoc-ref:GraphQL::Schema) uses this to match returned values to lazy resolution methods.
# Methods may be registered for classes, they apply to its subclasses also.
# The result of this lookup is cached for future resolutions.
# Instances of this class are thread-safe.
# See the schema's `lazy?` configuration to understand which values use this map.
#
# source://graphql//lib/graphql/execution/lazy/lazy_method_map.rb#19
class GraphQL::Execution::Lazy::LazyMethodMap
