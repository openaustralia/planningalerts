  # @return [Warden] a new instance of Warden
  #
  # source://graphql//lib/graphql/schema/warden.rb#214
  def initialize(context:, schema:); end

  # **Parameters**
  #
  # - `argument_owner` (`GraphQL::Field, GraphQL::InputObjectType`)
  #
  # **Returns**
  #
  # - `Array<GraphQL::Argument>` — Visible arguments on `argument_owner`
  #
  # :call-seq:
  #   arguments(GraphQL::Field | GraphQL::InputObjectType argument_owner, ctx) -> Array[GraphQL::Argument]
  #
  # source://graphql//lib/graphql/schema/warden.rb#389
  def arguments(argument_owner, ctx = T.unsafe(nil)); end

  # source://graphql//lib/graphql/schema/warden.rb#442
  def directives; end

  # **Returns**
  #
  # - `Array<GraphQL::EnumType::EnumValue>` — Visible members of `enum_defn`
  #
  # :call-seq:
  #   enum_values(enum_defn) -> Array[GraphQL::EnumType::EnumValue]
  #
  # source://graphql//lib/graphql/schema/warden.rb#409
  def enum_values(enum_defn); end

  # **Parameters**
  #
  # - `type_defn` (`GraphQL::ObjectType, GraphQL::InterfaceType`)
  #
  # **Returns**
  #
  # - `Array<GraphQL::Field>` — Fields on `type_defn`
  #
  # :call-seq:
  #   fields(GraphQL::ObjectType | GraphQL::InterfaceType type_defn) -> Array[GraphQL::Field]
  #
  # source://graphql//lib/graphql/schema/warden.rb#374
  def fields(type_defn); end

  # **Returns**
  #
  # - `GraphQL::Argument, nil` — The argument named `argument_name` on `parent_type`, if it exists and is visible
  #
  # :call-seq:
  #   get_argument(parent_type, argument_name) -> GraphQL::Argument | nil
  #
  # source://graphql//lib/graphql/schema/warden.rb#345
  def get_argument(parent_type, argument_name); end

  # **Returns**
  #
  # - `GraphQL::Field, nil` — The field named `field_name` on `parent_type`, if it exists
  #
  # :call-seq:
  #   get_field(parent_type, field_name) -> GraphQL::Field | nil
  #
  # source://graphql//lib/graphql/schema/warden.rb#324
  def get_field(parent_type, field_name); end

  # **Returns**
  #
  # - `GraphQL::BaseType, nil` — The type named `type_name`, if it exists (else `nil`)
  #
  # :call-seq:
  #   get_type(type_name) -> GraphQL::BaseType | nil
  #
  # source://graphql//lib/graphql/schema/warden.rb#284
  def get_type(type_name); end

  # source://graphql//lib/graphql/schema/warden.rb#484
  def interface_type_memberships(obj_type, _ctx = T.unsafe(nil)); end

  # **Returns**
  #
  # - `Array<GraphQL::InterfaceType>` — Visible interfaces implemented by `obj_type`
  #
  # :call-seq:
  #   interfaces(obj_type) -> Array[GraphQL::InterfaceType]
  #
  # source://graphql//lib/graphql/schema/warden.rb#431
  def interfaces(obj_type); end

  # **Returns**
  #
  # - `Boolean` — True if this type is used for `loads:` but not in the schema otherwise and not _explicitly_ hidden.
  #
  # :call-seq:
  #   loadable?(type, _ctx) -> bool
  #
  # @return [Boolean]
  #
  # source://graphql//lib/graphql/schema/warden.rb#258
  def loadable?(type, _ctx); end

