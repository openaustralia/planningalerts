# Serialization helpers for passing subscription data around.
#
# source://graphql//lib/graphql/subscriptions/serialize.rb#9
module GraphQL::Subscriptions::Serialize
  class << self
    # **Parameters**
    #
    # - `obj` (`Object`) — Some subscription-related data to dump
    #
    # **Returns**
    #
    # - `String` — The stringified object
    #
    # :call-seq:
    #   dump(Object obj) -> String
    #
    # source://graphql//lib/graphql/subscriptions/serialize.rb#45
    def dump(obj); end

    # This is for turning objects into subscription scopes.
    # It's a one-way transformation, can't reload this :'(
    #
    # **Parameters**
    #
    # - `obj` (`Object`)
    #
    # **Returns**
    #
    # - `String`
    #
    # :call-seq:
    #   dump_recursive(Object obj) -> String
    #
    # source://graphql//lib/graphql/subscriptions/serialize.rb#62
    def dump_recursive(obj); end

    # **Parameters**
    #
    # - `str` (`String`) — A serialized object from [.dump](rdoc-ref:.dump)
    #
    # **Returns**
    #
    # - `Object` — An object equivalent to the one passed to [.dump](rdoc-ref:.dump)
    #
    # :call-seq:
    #   load(String str) -> Object
    #
    # source://graphql//lib/graphql/subscriptions/serialize.rb#30
    def load(str); end

    private

    # **Parameters**
    #
    # - `obj` (`Object`) — Some subscription-related data to dump
    #
    # **Returns**
    #
    # - `Object` — The object that converted Global::Identification
    #
    # :call-seq:
    #   dump_value(Object obj) -> Object
    #
    # source://graphql//lib/graphql/subscriptions/serialize.rb#171
    def dump_value(obj); end

    # **Parameters**
    #
    # - `value` (`Object`) — A parsed JSON object
    #
    # **Returns**
    #
    # - `Object` — An object that load Global::Identification recursive
    #
    # :call-seq:
    #   load_value(Object value) -> Object
    #
    # source://graphql//lib/graphql/subscriptions/serialize.rb#92
    def load_value(value); end
  end
end

