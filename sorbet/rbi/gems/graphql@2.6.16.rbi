  # source://graphql//lib/graphql/schema/list.rb#86
  def ensure_array(value); end
end

# You can use the result of [GraphQL::Introspection::INTROSPECTION_QUERY](rdoc-ref:GraphQL::Introspection::INTROSPECTION_QUERY)
# to make a schema. This schema is missing some important details like
# `resolve` functions, but it does include the full type system,
# so you can use it to validate queries.
#
# See [GraphQL::Schema.from_introspection](rdoc-ref:GraphQL::Schema.from_introspection) for a public API
#
# source://graphql//lib/graphql/schema/loader.rb#12
module GraphQL::Schema::Loader
  class << self
    # source://graphql//lib/graphql/schema/loader.rb#207
    def build_arguments(arg_owner, args, type_resolver); end

    # source://graphql//lib/graphql/schema/loader.rb#183
    def build_fields(type_defn, fields, type_resolver); end

    # Create schema with the result of an introspection query.
    #
    # **Parameters**
    #
    # - `introspection_result` (`Hash`) — A response from [GraphQL::Introspection::INTROSPECTION_QUERY](rdoc-ref:GraphQL::Introspection::INTROSPECTION_QUERY)
    #
    # **Returns**
    #
    # - `Class` — the schema described by `input`
    #
    # :call-seq:
    #   load(Hash introspection_result) -> Class
    #
    # source://graphql//lib/graphql/schema/loader.rb#25
    def load(introspection_result); end

    private

    # source://graphql//lib/graphql/schema/loader.rb#170
    def define_directive(directive, type_resolver); end

    # source://graphql//lib/graphql/schema/loader.rb#108
    def define_type(type, type_resolver); end

    # source://graphql//lib/graphql/schema/loader.rb#87
    def extract_default_value(default_value_str, input_value_ast); end

    # source://graphql//lib/graphql/schema/loader.rb#68
    def resolve_type_reference(types, type); end
  end
end

# source://graphql//lib/graphql/schema/loader.rb#63
GraphQL::Schema::Loader::NullScalarCoerce = T.let(T.unsafe(nil), Proc)

# The base class for things that make up the schema,
# eg objects, enums, scalars.
#
# source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#9
class GraphQL::Schema::Member
  include ::GraphQL::Schema::Member::GraphQLTypeNames
  extend ::GraphQL::Schema::FindInheritedValue
  extend ::GraphQL::EmptyObjects
  extend ::GraphQL::Schema::Member::BaseDSLMethods
  extend ::GraphQL::Schema::Member::BaseDSLMethods::ConfigurationExtension
  extend ::GraphQL::Schema::Member::TypeSystemHelpers
  extend ::GraphQL::Schema::Member::Scoped
  extend ::GraphQL::Schema::Member::RelayShortcuts
  extend ::GraphQL::Schema::Member::HasPath
  extend ::GraphQL::Schema::Member::HasAstNode
  extend ::GraphQL::Schema::Member::HasDirectives

  class << self
    # : (GraphQL::Query::Context _ctx) -> bool
    #
    # @return [Boolean]
    #
    # source://graphql//lib/graphql/schema/member.rb#45
    def authorizes?(_ctx); end
  end
end

# DSL methods shared by lots of things in the GraphQL Schema.
# See classes that extend this, eg [GraphQL::Schema::Object](rdoc-ref:GraphQL::Schema::Object)
# --
# @requires_ancestor: Kernel
# @requires_ancestor: Module
#
# source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#15
module GraphQL::Schema::Member::BaseDSLMethods
  include ::GraphQL::Schema::FindInheritedValue
  include ::GraphQL::EmptyObjects

  # @return [Boolean]
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#166
  def authorized?(object, context); end

  # Call this method to provide a new comment; OR
  # call it without an argument to get the comment
  #
  # **Parameters**
  #
  # - `new_comment` (`String`)
  #
  # **Returns**
  #
  # - `String, nil`
  #
  # :call-seq:
  #   comment(String new_comment) -> String | nil
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#78
  def comment(new_comment = T.unsafe(nil)); end

  # Creates the default name for a schema member.
  # The default name is the Ruby constant name,
  # without any namespaces and with any `-Type` suffix removed
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#152
  def default_graphql_name; end

  # @return [Boolean]
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#170
  def default_relay?; end

  # Call this method to provide a new description; OR
  # call it without an argument to get the description
  #
  # **Parameters**
  #
  # - `new_description` (`String`)
  #
  # **Returns**
  #
  # - `String`
  #
  # :call-seq:
  #   description(String new_description) -> String
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#55
  def description(new_description = T.unsafe(nil)); end

  # Call this with a new name to override the default name for this schema member; OR
  # call it without an argument to get the name of this schema member
  #
  # The default name is implemented in default_graphql_name
  #
  # **Parameters**
  #
  # - `new_name` (`String`)
  #
  # **Returns**
  #
  # - `String`
  #
  # :call-seq:
  #   graphql_name(String new_name) -> String
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#33
  def graphql_name(new_name = T.unsafe(nil)); end

  # **Returns**
  #
  # - `Boolean` — If true, this object is part of the introspection system
  #
  # :call-seq:
  #   introspection(new_introspection) -> bool
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#115
  def introspection(new_introspection = T.unsafe(nil)); end

  # @return [Boolean]
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#125
  def introspection?; end

  # The mutation this type was derived from, if it was derived from a mutation
  #
  # **Returns**
  #
  # - `Class`
  #
  # :call-seq:
  #   mutation(mutation_class) -> Class
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#137
  def mutation(mutation_class = T.unsafe(nil)); end

  def unwrap; end

  # @return [Boolean]
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#162
  def visible?(context); end

  protected

  # Sets the attribute default_graphql_name
  #
  # @param value the value to set the attribute default_graphql_name to.
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#176
  def default_graphql_name=(_arg0); end

  # Sets the attribute graphql_name
  #
  # @param value the value to set the attribute graphql_name to.
  #
  # source://graphql//lib/graphql/schema/member/base_dsl_methods.rb#176
  def graphql_name=(_arg0); end
end

