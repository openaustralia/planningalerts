  #
  # @return [Boolean]
  #
  # source://graphql//lib/graphql/analysis/visitor.rb#89
  def skipping?; end

  # **Returns**
  #
  # - `GraphQL::BaseType` — The current object type
  #
  # :call-seq:
  #   type_definition() -> GraphQL::BaseType
  #
  # source://graphql//lib/graphql/analysis/visitor.rb#256
  def type_definition; end

  # source://graphql//lib/graphql/analysis/visitor.rb#54
  def visit; end

  # **Returns**
  #
  # - `Boolean` — If the visitor is currently inside a fragment definition
