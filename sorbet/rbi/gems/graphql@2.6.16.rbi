  # **Returns**
  #
  # - `GraphQL::Query::Context`
  #
  # source://graphql//lib/graphql/load_application_object_failed_error.rb#26
  def context; end

  # **Returns**
  #
  # - `String` — The ID provided by the client
  #
  # source://graphql//lib/graphql/load_application_object_failed_error.rb#18
  def id; end

  # **Returns**
  #
  # - `Object` — The value found with this ID
  #
  # source://graphql//lib/graphql/load_application_object_failed_error.rb#22
  def object; end
end

