  # source://graphql//lib/graphql/schema/list.rb#51
  def coerce_result(value, ctx); end

  # Also for implementing introspection
  #
  # source://graphql//lib/graphql/schema/list.rb#47
  def description; end

  # This is for introspection, where it's expected the name will be `null`
  #
  # source://graphql//lib/graphql/schema/list.rb#42
  def graphql_name; end

  # **Returns**
  #
  # - `GraphQL::TypeKinds::LIST`
  #
  # :call-seq:
  #   kind() -> GraphQL::TypeKinds::LIST
  #
  # source://graphql//lib/graphql/schema/list.rb#19
  def kind; end

  # **Returns**
  #
  # - `true`
  #
  # :call-seq:
  #   list?() -> true
  #
  # @return [Boolean]
  #
  # source://graphql//lib/graphql/schema/list.rb#29
  def list?; end

  # source://graphql//lib/graphql/schema/list.rb#33
  def to_type_signature; end

  # source://graphql//lib/graphql/schema/list.rb#64
