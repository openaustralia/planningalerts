  private

  # source://graphql//lib/graphql/execution/lazy/lazy_method_map.rb#63
  def find_superclass_method(value_class); end

  # source://graphql//lib/graphql/execution/lazy/lazy_method_map.rb#24
  def initialize_copy(other); end
end

