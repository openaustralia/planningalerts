  # @return [Boolean]
  #
  # source://graphql//lib/graphql/static_validation/rules/fields_will_merge.rb#644
  def field_groups_already_compared?(fields, fields2, mutually_exclusive); end

  # source://graphql//lib/graphql/static_validation/rules/fields_will_merge.rb#435
  def field_selection_signature(field); end

  # source://graphql//lib/graphql/static_validation/rules/fields_will_merge.rb#450
  def field_signature(field); end

  # @return [Boolean]
  #
  # source://graphql//lib/graphql/static_validation/rules/fields_will_merge.rb#440
  def fields_same_signature?(f1, f2); end

  # source://graphql//lib/graphql/static_validation/rules/fields_will_merge.rb#462
