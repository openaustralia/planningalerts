  # source://graphql//lib/graphql/schema/warden.rb#266
  def loadable_possible_types(abstract_type, _ctx); end

  # **Returns**
  #
  # - `Array<GraphQL::BaseType>` — The types which may be member of `type_defn`
  #
  # :call-seq:
  #   possible_types(type_defn) -> Array[GraphQL::BaseType]
  #
  # source://graphql//lib/graphql/schema/warden.rb#356
