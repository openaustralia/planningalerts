# This module exposes Fiber-level runtime information.
#
# It won't work across unrelated fibers, although it will work in child Fibers.
#
# **Examples**
#
# **Example: Setting Up ActiveRecord::QueryLogs**
#
# ```ruby
# config.active_record.query_log_tags = [
#   :namespaced_controller,
#   :action,
#   :job,
#   # ...
#   {
#     # GraphQL runtime info:
#     current_graphql_operation: -> { GraphQL::Current.operation_name },
#     current_graphql_field: -> { GraphQL::Current.field&.path },
#     current_dataloader_source: -> { GraphQL::Current.dataloader_source_class },
#     # ...
#   },
# ]
# ```
#
# source://graphql//lib/graphql/current.rb#29
module GraphQL::Current
  class << self
    # **Returns**
    #
    # - `GraphQL::Dataloader::Source, nil` — The currently-running source, if there is one
    #
    # :call-seq:
    #   dataloader_source() -> GraphQL::Dataloader::Source | nil
    # : () -> GraphQL::Dataloader::Source?
    #
    # source://graphql//lib/graphql/current.rb#89
    def dataloader_source; end

    # **Returns**
    #
    # - `Class, nil` — The currently-running [Dataloader::Source](rdoc-ref:Dataloader::Source) class, if there is one.
    #
    # :call-seq:
    #   dataloader_source_class() -> Class | nil
    # : () -> singleton(GraphQL::Dataloader::Source)?
    #
    # source://graphql//lib/graphql/current.rb#78
    def dataloader_source_class; end

    # See [Schema::Member::HasPath#path](rdoc-ref:GraphQL::Schema::Member::HasPath#path) for a string identifying this field
    #
    # **Returns**
    #
    # - `GraphQL::Field, nil` — The currently-running field, if there is one.
    #
    # :call-seq:
    #   field() -> GraphQL::Field | nil
    # : () -> GraphQL::Schema::Field?
    #
    # source://graphql//lib/graphql/current.rb#61
    def field; end

    # **Returns**
    #
    # - `String, nil` — Comma-joined operation names for the currently-running `Execution::Multiplex`. `nil` if all operations are anonymous.
    #
    # :call-seq:
    #   operation_name() -> String | nil
    # : () -> String?
    #
    # source://graphql//lib/graphql/current.rb#37
    def operation_name; end
  end
end

# Rails expects the engine to be called `Graphql::Dashboard`,
# but `GraphQL::Dashboard` is consistent with this gem's naming.
# So define both constants to refer to the same class.
#
# source://graphql//lib/graphql/dashboard.rb#114
GraphQL::Dashboard = Graphql::Dashboard

# This plugin supports Fiber-based concurrency, along with [GraphQL::Dataloader::Source](rdoc-ref:GraphQL::Dataloader::Source).
#
# **Examples**
#
# **Example: Installing Dataloader**
#
# ```ruby
# class MySchema < GraphQL::Schema
#   use GraphQL::Dataloader
# end
# ```
#
# **Example: Waiting for batch-loaded data in a GraphQL field**
#
# ```ruby
# field :team, Types::Team, null: true
#
# def team
#   dataloader.with(Sources::Record, Team).load(object.team_id)
# end
# ```
#
# source://graphql//lib/graphql/dataloader/null_dataloader.rb#6
class GraphQL::Dataloader
  # @return [Dataloader] a new instance of Dataloader
  #
  # source://graphql//lib/graphql/dataloader.rb#67
  def initialize(nonblocking: T.unsafe(nil), fiber_limit: T.unsafe(nil)); end

  # source://graphql//lib/graphql/dataloader.rb#177
  def append_job(callable = T.unsafe(nil), &job); end

  # This method is called when Dataloader is finished using a fiber.
  # Use it to perform any cleanup, such as releasing database connections (if required manually)
  #
  # source://graphql//lib/graphql/dataloader.rb#126
  def cleanup_fiber; end

  # Clear any already-loaded objects from [Source](rdoc-ref:Source) caches
  #
  # **Returns**
  #
  # - `void`
  #
  # :call-seq:
  #   clear_cache() -> void
  #
  # source://graphql//lib/graphql/dataloader.rb#199
  def clear_cache; end

  # **Returns**
  #
  # - `Integer, nil`
  #
  # source://graphql//lib/graphql/dataloader.rb#82
  def fiber_limit; end

  # This is called before the fiber is spawned, from the parent context (i.e. from
  # the thread or fiber that it is scheduled from).
  #
  # **Returns**
  #
  # - `Hash<Symbol, Object>` — Current fiber-local variables
  #
  # :call-seq:
  #   get_fiber_variables() -> Hash[Symbol, Object]
  #
  # source://graphql//lib/graphql/dataloader.rb#97
  def get_fiber_variables; end

  # source://graphql//lib/graphql/dataloader.rb#300
  def lazy_at_depth(depth, lazy); end

  # Pre-warm the Dataloader cache with ActiveRecord objects which were loaded elsewhere.
  # These will be used by [Dataloader::ActiveRecordSource](rdoc-ref:Dataloader::ActiveRecordSource), [Dataloader::ActiveRecordAssociationSource](rdoc-ref:Dataloader::ActiveRecordAssociationSource) and their helper
  # methods, `dataload_record` and `dataload_association`.
  #
  # **Parameters**
  #
  # - `records` (`Array<ActiveRecord::Base>`) — Already-loaded records to warm the cache with
  # - `index_by` (`Symbol`) — The attribute to use as the cache key. (Should match `find_by:` when using [ActiveRecordSource](rdoc-ref:ActiveRecordSource))
  #
  # **Returns**
  #
  # - `void`
  #
  # :call-seq:
  #   merge_records(Array[ActiveRecord::Base] records, Symbol index_by:) -> void
  #
  # source://graphql//lib/graphql/dataloader.rb#331
  def merge_records(records, index_by: T.unsafe(nil)); end

  # @return [Boolean]
  #
  # source://graphql//lib/graphql/dataloader.rb#84
  def nonblocking?; end

  # source://graphql//lib/graphql/dataloader.rb#184
  def queue_pending_source(source); end

  # **Parameters**
  #
  # - `trace_query_lazy` (`nil, Execution::Multiplex`)
  #
  # :call-seq:
  #   run(nil | Execution::Multiplex trace_query_lazy:)
  #
  # source://graphql//lib/graphql/dataloader.rb#251
  def run(trace_query_lazy: T.unsafe(nil)); end

  # source://graphql//lib/graphql/dataloader.rb#296
  def run_fiber(f); end

  # Use a self-contained queue for the work in the block.
  #
  # source://graphql//lib/graphql/dataloader.rb#207
  def run_isolated; end

  # Set up the fiber variables in a new fiber.
  #
  # This is called within the fiber, right after it is spawned.
  #
  # **Parameters**
  #
  # - `vars` (`Hash<Symbol, Object>`) — Fiber-local variables from [get_fiber_variables](rdoc-ref:get_fiber_variables)
  #
  # **Returns**
  #
  # - `void`
  #
  # :call-seq:
  #   set_fiber_variables(Hash[Symbol, Object] vars) -> void
  #
  # source://graphql//lib/graphql/dataloader.rb#119
  def set_fiber_variables(vars); end

  # source://graphql//lib/graphql/dataloader.rb#304
  def spawn_fiber; end

  # source://graphql//lib/graphql/dataloader.rb#150
  def with(source_class, *batch_args, **batch_kwargs); end

  # Tell the dataloader that this fiber is waiting for data.
  #
  # Dataloader will resume the fiber after the requested data has been loaded (by another Fiber).
  #
  # **Returns**
  #
  # - `void`
  #
  # :call-seq:
  #   yield(source:) -> void
  #
  # source://graphql//lib/graphql/dataloader.rb#169
  def yield(source = T.unsafe(nil)); end

  private

  # source://graphql//lib/graphql/dataloader.rb#391
  def calculate_fiber_limit; end

  # source://graphql//lib/graphql/dataloader.rb#430
  def dequeue_pending_source; end

  # source://graphql//lib/graphql/dataloader.rb#421
  def drain_pending_sources; end

  # Returns true if anything was actually enqueued
  #
  # source://graphql//lib/graphql/dataloader.rb#344
  def enqueue_next_pending_lazies(lazies_at_depth); end

  # source://graphql//lib/graphql/dataloader.rb#402
  def join_queues(prev_queue, new_queue); end

  # source://graphql//lib/graphql/dataloader.rb#358
  def run_pending_steps(trace, job_fibers, next_job_fibers, jobs_fiber_limit, source_fibers, next_source_fibers, total_fiber_limit); end

  # source://graphql//lib/graphql/dataloader.rb#408
  def spawn_job_fiber(trace); end

  # source://graphql//lib/graphql/dataloader.rb#437
  def spawn_source_fiber(trace); end

  # source://graphql//lib/graphql/dataloader.rb#382
  def with_trace_query_lazy(multiplex_or_nil, &block); end

  class << self
    # Returns the value of attribute default_fiber_limit.
    #
    # source://graphql//lib/graphql/dataloader.rb#36
    def default_fiber_limit; end

    # Sets the attribute default_fiber_limit
    #
    # @param value the value to set the attribute default_fiber_limit to.
    #
    # source://graphql//lib/graphql/dataloader.rb#36
    def default_fiber_limit=(_arg0); end

    # Returns the value of attribute default_nonblocking.
    #
    # source://graphql//lib/graphql/dataloader.rb#36
    def default_nonblocking; end

    # Sets the attribute default_nonblocking
    #
    # @param value the value to set the attribute default_nonblocking to.
    #
    # source://graphql//lib/graphql/dataloader.rb#36
    def default_nonblocking=(_arg0); end

    # source://graphql//lib/graphql/dataloader.rb#39
    def use(schema, nonblocking: T.unsafe(nil), fiber_limit: T.unsafe(nil)); end

    # Call the block with a Dataloader instance,
    # then run all enqueued jobs and return the result of the block.
    #
    # source://graphql//lib/graphql/dataloader.rb#57
    def with_dataloading(&block); end
  end
end

