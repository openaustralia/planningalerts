  # : (untyped relation) -> Integer?
  #
  # source://graphql//lib/graphql/pagination/active_record_relation_connection.rb#31
  def relation_limit(relation); end

  # : (untyped relation) -> Integer?
  #
  # source://graphql//lib/graphql/pagination/active_record_relation_connection.rb#40
  def relation_offset(relation); end

  # : (untyped nodes, Integer limit) -> untyped
