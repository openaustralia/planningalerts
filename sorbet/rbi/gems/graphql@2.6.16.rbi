# source://graphql//lib/graphql/dataloader/async_dataloader.rb#7
class GraphQL::Dataloader::AsyncDataloader < ::GraphQL::Dataloader
  # @return [AsyncDataloader] a new instance of AsyncDataloader
  #
  # source://graphql//lib/graphql/dataloader/async_dataloader.rb#23
