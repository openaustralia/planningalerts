  # source://graphql//lib/graphql/pagination/connections.rb#48
  def all_wrappers; end

  # source://graphql//lib/graphql/pagination/connections.rb#44
  def delete(nodes_class); end

  # use an override if there is one
  #
  # source://graphql//lib/graphql/pagination/connections.rb#126
  def edge_class_for_field(field); end

  # source://graphql//lib/graphql/pagination/connections.rb#95
  def populate_connection(field, object, value, original_arguments, context); end

  # Used by the runtime to wrap values in connection wrappers.
  #
  # source://graphql//lib/graphql/pagination/connections.rb#70
  def wrap(field, parent, items, arguments, context); end

  # source://graphql//lib/graphql/pagination/connections.rb#58
  def wrapper_for(items, wrappers: T.unsafe(nil)); end

  protected

  # Returns the value of attribute wrappers.
  #
  # source://graphql//lib/graphql/pagination/connections.rb#137
  def wrappers; end

  private

  # source://graphql//lib/graphql/pagination/connections.rb#141
  def add_default; end
end

