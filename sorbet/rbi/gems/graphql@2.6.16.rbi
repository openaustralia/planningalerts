    # source://graphql//lib/graphql/schema.rb#2261
    def after_any_lazies(maybe_lazies); end

    # Call the given block at the right time, either:
    # - Right away, if `value` is not registered with `lazy_resolve`
    # - After resolving `value`, if it's registered with `lazy_resolve` (eg, `Promise`)
    #
    # source://graphql//lib/graphql/schema.rb#2204
    def after_lazy(value, &block); end

    # This setting controls how GraphQL-Ruby handles empty selections on Union types.
    #
    # To opt into future, spec-compliant behavior where these selections are rejected, set this to `false`.
    #
    # If you need to support previous, non-spec behavior which allowed selecting union fields
    # but *not* selecting any fields on that union, set this to `true` to continue allowing that behavior.
    #
    # If this is `true`, then [.legacy_invalid_empty_selections_on_union_with_type](rdoc-ref:.legacy_invalid_empty_selections_on_union_with_type) will be called with [Query](rdoc-ref:Query) objects
    # with that kind of selections. You must implement that method
    #
    # **Parameters**
    #
    # - `new_value` (`Boolean`)
    #
    # **Returns**
    #
    # - `true, false, nil`
    #
    # :call-seq:
    #   allow_legacy_invalid_empty_selections_on_union(bool new_value) -> true | false | nil
    #
    # source://graphql//lib/graphql/schema.rb#2306
    def allow_legacy_invalid_empty_selections_on_union(new_value = T.unsafe(nil)); end

    # This setting controls how GraphQL-Ruby handles fields with the same response name but different names or arguments,
    # when previous versions of GraphQL-Ruby treated them as mutually exclusive, but the GraphQL spec doesn't.
    # The spec treats fields as mutually exclusive only when their parent types are different object types. For example:
    #
    # - `... on Product { ...ProductFields options(first: 2) { id } }`, when `ProductFields` also selects `options` on `Product`
    # - `... on Feline { volume: meowVolume }` and `... on Canine { volume: barkVolume }`, when `Feline` and `Canine` are interfaces
    #
    # When set to `false`, GraphQL-Ruby will reject those queries with a validation error (as per the GraphQL spec).
    #
    # When set to `true`, GraphQL-Ruby will call [.legacy_invalid_field_conflicts](rdoc-ref:.legacy_invalid_field_conflicts) when the scenario is encountered.
    #
    # When not configured, GraphQL-Ruby allows those queries and logs a warning.
    #
    # **Parameters**
    #
    # - `new_value` (`Boolean`) — `true` permits the legacy behavior, `false` rejects it.
    #
    # **Returns**
    #
    # - `true, false, nil`
    #
    # :call-seq:
    #   allow_legacy_invalid_field_conflicts(bool new_value) -> true | false | nil
    #
    # source://graphql//lib/graphql/schema.rb#2507
    def allow_legacy_invalid_field_conflicts(new_value = T.unsafe(nil)); end

    # This setting controls how GraphQL-Ruby handles overlapping selections on scalar types when the types
    # don't match.
    #
    # When set to `false`, GraphQL-Ruby will reject those queries with a validation error (as per the GraphQL spec).
    #
    # When set to `true`, GraphQL-Ruby will call [.legacy_invalid_return_type_conflicts](rdoc-ref:.legacy_invalid_return_type_conflicts) when the scenario is encountered.
    #
    # **Parameters**
    #
    # - `new_value` (`Boolean`) — `true` permits the legacy behavior, `false` rejects it.
    #
    # **Returns**
    #
    # - `true, false, nil`
    #
    # :call-seq:
    #   allow_legacy_invalid_return_type_conflicts(bool new_value) -> true | false | nil
    #
    # source://graphql//lib/graphql/schema.rb#2444
    def allow_legacy_invalid_return_type_conflicts(new_value = T.unsafe(nil)); end

    # This setting controls how GraphQL-Ruby handles variable usages which the GraphQL spec doesn't allow,
    # but which previous versions of GraphQL-Ruby didn't reject:
    #
    # - A variable in a fragment, when the fragment comes before the operation, or when another operation uses the fragment
    # - A nullable variable with a `= null` default value, in a non-null position
