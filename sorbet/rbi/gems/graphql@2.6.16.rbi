  # Returns the value of attribute own_directives.
  #
  # source://graphql//lib/graphql/schema/member/has_directives.rb#147
  def own_directives; end

  # Sets the attribute own_directives
  #
  # @param value the value to set the attribute own_directives to.
  #
  # source://graphql//lib/graphql/schema/member/has_directives.rb#147
  def own_directives=(_arg0); end

  class << self
    # source://graphql//lib/graphql/schema/member/has_directives.rb#60
    def add_directive(schema_member, directives, directive_class, directive_options); end

    # @private
    #
    # source://graphql//lib/graphql/schema/member/has_directives.rb#9
    def extended(child_cls); end

    # source://graphql//lib/graphql/schema/member/has_directives.rb#69
    def get_directives(schema_member, directives, directives_method); end

    # source://graphql//lib/graphql/schema/member/has_directives.rb#65
    def remove_directive(directives, directive_class); end

    private

    # Modify `target` by adding items from `dirs` such that:
    # - Any name conflict is overridden by the incoming member(s) of `dirs`.
    #   (Repeatable directives replace _all_ same-named directives in `target`, and all incoming ones are kept.)
    # - Any other member of `dirs` is appended
