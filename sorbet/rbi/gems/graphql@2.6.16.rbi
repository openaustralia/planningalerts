  def object_types; end

  # source://graphql//lib/graphql/analysis/visitor.rb#203
  def on_argument(node, parent); end

  # source://graphql//lib/graphql/analysis/visitor.rb#193
  def on_directive(node, parent); end

  # source://graphql//lib/graphql/analysis/visitor.rb#163
  def on_field(node, parent); end

  # source://graphql//lib/graphql/analysis/visitor.rb#229
  def on_fragment_spread(node, parent); end

  # source://graphql//lib/graphql/analysis/visitor.rb#144
  def on_inline_fragment(node, parent); end

  # source://graphql//lib/graphql/analysis/visitor.rb#130
  def on_operation_definition(node, parent); end

  # **Returns**
  #
  # - `GraphQL::BaseType` — The type which the current type came from
  #
  # :call-seq:
  #   parent_type_definition() -> GraphQL::BaseType
  #
  # source://graphql//lib/graphql/analysis/visitor.rb#266
  def parent_type_definition; end

  # **Returns**
  #
  # - `GraphQL::Argument, nil` — The previous GraphQL argument
  #
  # :call-seq:
  #   previous_argument_definition() -> GraphQL::Argument | nil
  #
  # source://graphql//lib/graphql/analysis/visitor.rb#316
  def previous_argument_definition; end

  # **Returns**
  #
  # - `GraphQL::Field, nil` — The GraphQL field which returned the object that the current field belongs to
  #
  # :call-seq:
  #   previous_field_definition() -> GraphQL::Field | nil
  #
  # source://graphql//lib/graphql/analysis/visitor.rb#286
  def previous_field_definition; end

  # **Returns**
  #
  # - `GraphQL::Query` — the query being visited
