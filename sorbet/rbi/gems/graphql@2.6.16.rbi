    # : (Array[GraphQL::Language::Nodes::Field] ast_nodes, untyped parent_type, GraphQL::Schema::Field field_defn, Array[untyped] objects, Hash[Symbol, untyped] arguments, GraphQL::Query::Context context) -> Transformer?
    #
    # source://graphql//lib/graphql/schema/directive/transform.rb#70
    def resolve_field(ast_nodes, parent_type, field_defn, objects, arguments, context); end
  end
end

# source://graphql//lib/graphql/schema/directive/transform.rb#40
GraphQL::Schema::Directive::Transform::TRANSFORMS = T.let(T.unsafe(nil), Array)

# source://graphql//lib/graphql/schema/directive/transform.rb#79
class GraphQL::Schema::Directive::Transform::Transformer
  include ::GraphQL::Execution::PostProcessor

  # : (String transform) -> void
  #
  # @return [Transformer] a new instance of Transformer
  #
  # source://graphql//lib/graphql/schema/directive/transform.rb#82
  def initialize(transform); end

  # : (Array[untyped] field_results) -> Array[untyped]
  #
  # source://graphql//lib/graphql/schema/directive/transform.rb#86
  def after_resolve(field_results); end
end

