<% content_for :page_title, t(".page_title") %>

<%= render CentreBlockWithImageComponent.new do |c| %>
  <% c.with_heading do %>
    <%= t(".heading") %>
  <% end %>

  <% c.with_image do %>
    <%= image_tag "illustration/no_results.svg", alt: "" %>
  <% end %>

  <p class="text-xl text-navy">
    <%= pa_link_to t(".back_to_application"), application_path(application) %>
  </p>
<% end %>
