// Dev container for VS Code, RubyMine, Codespaces and the devcontainer CLI. It opens the `web` container of the
// same stack `make up` starts. See "Getting a working environment" in AGENTS.md.
{
  "name": "PlanningAlerts",
  "dockerComposeFile": "../compose.yaml",
  "service": "web",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  // Waits for the app to finish starting, so the first command you run works. Gives up after START_LIMIT (compose.yaml).
  "postStartCommand": ["sh", ".devcontainer/wait-for-app.sh", "web", "bin/setup and Rails", "curl", "-fs", "-o", "/dev/null", "http://localhost:3000/health_check"],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish"
      },
      "extensions": [
        "shopify.ruby-lsp",
        "karunamurti.haml",
        "deibit.devdocs",
        "manuelpuyol.erb-linter",
        "GitHub.vscode-pull-request-github",
        "aki77.haml-lint",
        "sorbet.sorbet-vscode-extension",
        "misogi.ruby-rubocop",
        "syler.sass-indented",
        "bradlc.vscode-tailwindcss",
        "jock.svg",
        "heybourn.headwind",
        "figma.figma-vscode-extension",
        "github.vscode-github-actions",
        "gruntfuggly.todo-tree"
      ]
    }
  },
  "remoteEnv": {
    "EDITOR": "code -w -r"
  }
}
