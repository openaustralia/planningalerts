# Copy this to .env (which is gitignored) and fill in the values you need. Never commit real keys.
# Production reads the same settings from the encrypted Rails credentials, not from here.

# Google Maps. Use restricted development keys, not the production ones.
# Without them maps and address lookups don't work.
# The free Maps Demo Key (https://mapsplatform.google.com/maps-demo-key/) can go in both the API and SERVER keys.
# The static map and street view images (EMAIL and CRYPTOGRAPHIC keys) need a standard key. See "API keys in
# development" in the README.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_EMAIL_KEY=
GOOGLE_MAPS_CRYPTOGRAPHIC_KEY=

# Your own morph.io API key (free from your account on https://morph.io).
# Without it the "Import applications" button in the admin is refused.
MORPH_API_KEY=
